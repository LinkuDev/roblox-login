# ---------- App ----------
APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# ---------- Database ----------
# dev:  sqlite:///./data/app.db
# prod: postgresql+psycopg://user:pass@localhost:5432/rlx
DATABASE_URL=sqlite:///./data/app.db

# ---------- Queue ----------
# memory | redis
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ---------- Captcha ----------
# Doi provider chi bang bien nay: twocaptcha | capsolver | anticaptcha | manual
CAPTCHA_PROVIDER=twocaptcha
CAPTCHA_TIMEOUT=180
CAPTCHA_POLL_INTERVAL=5
TWOCAPTCHA_API_KEY=
CAPSOLVER_API_KEY=
ANTICAPTCHA_API_KEY=

# ---------- Browser ----------
# botasaurus | (future) playwright
BROWSER_PROVIDER=botasaurus
BROWSER_HEADLESS=true
BROWSER_WINDOW_SIZE=1280,800
BROWSER_TIMEOUT=45
BROWSER_PROFILE_DIR=./data/profiles

# ---------- Proxy ----------
# none | static | (future) rotating api
PROXY_PROVIDER=none
PROXY_LIST_FILE=./data/proxies.txt

# ---------- Billing ----------
POINT_SIGNUP_BONUS=0
