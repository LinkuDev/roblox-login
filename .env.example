# ============================================================================
#  .env cho SaaS server (src/app). Copy -> .env
#
#  Node standalone KHONG dung file nay: cau hinh browser/captcha/proxy/rotate cua
#  node nam o ~/.roblox-node/config.json (chinh qua UI node). Cac tinh chinh flow
#  (captcha timeout, headless...) da co default hop ly trong code.
# ============================================================================

# ---------- App ----------
APP_ENV=dev
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
APP_LOG_LEVEL=INFO
# Email tu dong len ADMIN luc register (ngan cach dau phay). Admin = topup diem +
# tao API key cho NODE claim pool. Node connect pool = dung API key cua admin nay.
APP_ADMIN_EMAILS=
# Origin FE (Next.js repo rieng) duoc phep goi API qua CORS (ngan cach dau phay).
# "*" = tat ca (auth qua Bearer/X-API-Key, khong dung cookie). Vd:
# APP_CORS_ORIGINS=http://localhost:3000,https://app.mysaas.com
APP_CORS_ORIGINS=*

# ---------- Database ----------
# dev:  sqlite:///./data/app.db          (mac dinh, khong can cai gi)
# SaaS: postgresql+psycopg://user:pass@host:5432/rlx   (KHUYEN NGHI - pool nhieu
#       node dung FOR UPDATE SKIP LOCKED; docker-compose da dung Postgres san)
DATABASE_URL=sqlite:///./data/app.db

# ---------- Billing ----------
POINT_SIGNUP_BONUS=0

# ---------- Nap diem qua crypto ----------
# provider: `manual` (mac dinh - hien dia chi vi + admin/webnoi bo confirm) hoac
#           `nowpayments` (goi HTTP that, xac thuc IPN bang HMAC).
CRYPTO_PROVIDER=manual
CRYPTO_ENABLED=true
# 1 USD (stablecoin) = bao nhieu diem. total_usd = amount_points / points_per_usd.
CRYPTO_POINTS_PER_USD=1000
CRYPTO_MIN_POINTS=1000
CRYPTO_DEPOSIT_TTL_MINUTES=60
CRYPTO_CURRENCIES=USDT,USDC,BTC,ETH
# provider=manual: dia chi vi nhan tien (hien cho user).
CRYPTO_WALLET_ADDRESS=
# provider=nowpayments: khoa API + IPN secret (xac thuc webhook) + URL callback public.
CRYPTO_API_KEY=
CRYPTO_IPN_SECRET=
CRYPTO_CALLBACK_BASE=
