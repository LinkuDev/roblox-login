# ============================================================================
#  .env cho PROD tren VPS. Copy -> .env, sua cac cho ###DOI###.
#  Chay:  docker compose --env-file .env -f docker/docker-compose.prod.yml up -d --build
#
#  Luu y: docker-compose.prod.yml se GHI DE APP_ENV=prod va DATABASE_URL (tro toi
#  service `db`) nen 2 dong do o day chi de tham khao. POSTGRES_* duoi day duoc
#  compose dung de tao DB + ghep DATABASE_URL.
# ============================================================================

# ---------- App ----------
APP_ENV=prod
APP_DEBUG=false
# ###DOI###: chuoi ngau nhien dai (vd: openssl rand -hex 32). Ky JWT - doi = het han het token.
APP_SECRET_KEY=change-me-please-openssl-rand-hex-32
APP_LOG_LEVEL=INFO
# Email tu dong len ADMIN luc register. Admin = topup diem + tao API key cho node pool.
APP_ADMIN_EMAILS=you@example.com
# ###DOI###: origin FE Next.js (repo rieng). Nhieu domain ngan bang dau phay. Tranh "*"
# o prod neu co the.
APP_CORS_ORIGINS=https://app.yourdomain.com

# ---------- Postgres (compose dung de tao DB + ghep DATABASE_URL) ----------
POSTGRES_USER=rlx
# ###DOI###: mat khau DB manh.
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=rlx
# So worker uvicorn (mac dinh 4). Tang neu VPS nhieu core.
WEB_CONCURRENCY=4

# DATABASE_URL: compose se tu set tro toi `db`. (Neu chay KHONG qua compose, bo comment:)
# DATABASE_URL=postgresql+psycopg://rlx:change-me-strong-db-password@localhost:5432/rlx

# ---------- Billing ----------
POINT_SIGNUP_BONUS=0

# ---------- Nap diem qua crypto ----------
# Moi bien duoi day DEU CO DEFAULT trong code -> chi can khai bao cai nao muon doi.
CRYPTO_PROVIDER=nowpayments        # `manual` (confirm tay) | `nowpayments` (tu dong)
CRYPTO_ENABLED=true
# Chung (ca 2 provider):
CRYPTO_USD_PER_POINT=0.03          # gia ban: 1 diem = 0.03 USD (nap $X -> X/0.03 diem)
CRYPTO_MIN_USD=1                   # nap toi thieu / lan tinh theo USD ($1). Bo -> default 1
CRYPTO_DEPOSIT_TTL_MINUTES=60      # lenh pending song 60' roi tu expired
# Coin cho phep: DE TRONG -> NOWPayments tu quyet (khuyen nghi). Chi dien neu muon
# ep 1 tap con, vd chi nhan stablecoin:  CRYPTO_CURRENCIES=USDT,USDC
CRYPTO_CURRENCIES=

# --- Chi khi CRYPTO_PROVIDER=nowpayments ---
CRYPTO_API_KEY=                    # ###DOI### khoa API NOWPayments
CRYPTO_IPN_SECRET=                 # ###DOI### IPN secret (xac thuc webhook)
CRYPTO_CALLBACK_BASE=              # ###DOI### domain public BE, vd https://api.yourdomain.com

# --- Chi khi CRYPTO_PROVIDER=manual (dung nowpayments thi BO TRONG) ---
CRYPTO_WALLET_ADDRESS=            # dia chi vi tu nhan tien (nowpayments khong dung)
